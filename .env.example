# Discord runtime
DISCORD_APP_ID=YOUR_APPLICATION_ID
DISCORD_PUBLIC_KEY=YOUR_PUBLIC_KEY
# Needed only when running `npm run register`. Keep it out of screenshots and GitHub secrets.
DISCORD_BOT_TOKEN=YOUR_NEW_BOT_TOKEN
REGISTER_COMMANDS_ON_START=true

HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=https://YOUR-SERVICE.up.railway.app

# Translation: libretranslate | google | deepl
TRANSLATION_PROVIDER=libretranslate
# Railway example: http://libretranslate.railway.internal:5000
# Docker Compose example: http://libretranslate:5000
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Optional voice STT
# Railway example: http://stt.railway.internal:8000
# Docker Compose example: http://stt:8000
STT_URL=http://stt:8000
STT_API_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET
MAX_AUDIO_BYTES=15728640
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

DATA_DIR=./data
DEFAULT_INCOMING_LANGUAGE=ar
DEFAULT_OUTGOING_LANGUAGE=en
