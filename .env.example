# Discord
DISCORD_APP_ID=YOUR_APPLICATION_ID
DISCORD_PUBLIC_KEY=YOUR_PUBLIC_KEY
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN
REGISTER_COMMANDS_ON_START=true
ENABLE_GUILD_VOICE_AI=true

HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=https://YOUR-SERVICE.up.railway.app

# Text AI
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-3.7-flash
AI_ACTION_MAX_CHARS=8000
AI_ACTION_TIMEOUT_MS=60000

# Translation
TRANSLATION_PROVIDER=ai
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# LOW-LATENCY VOICE
VOICE_AI_MODE=live
# Optional dedicated key. If empty, AI_API_KEY is reused.
GEMINI_LIVE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_THINKING_LEVEL=minimal

# 250-350ms is a good starting point for fast turn-taking.
VOICE_AI_SILENCE_MS=300
VOICE_AI_MAX_UTTERANCE_SECONDS=35
VOICE_AI_MAX_HISTORY=12

# Cascade fallback only (not used when VOICE_AI_MODE=live)
VOICE_AI_MODEL=gemini-3.7-flash
STT_PROVIDER=gemini
STT_URL=
STT_API_KEY=
GEMINI_STT_API_KEY=
GEMINI_STT_MODEL=gemini-3.1-flash-lite
MAX_AUDIO_BYTES=15728640

GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
TTS_MAX_CHARS=4000
TTS_REQUEST_TIMEOUT_MS=120000

CHAT_SESSION_TTL_MINUTES=120
CHAT_MAX_HISTORY=20
CHAT_MAX_INPUT_CHARS=6000

DATA_DIR=./data
DEFAULT_INCOMING_LANGUAGE=ar-eg
DEFAULT_OUTGOING_LANGUAGE=en
